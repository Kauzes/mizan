{
  "uid": "mizan-platform-up",
  "title": "Mizan \u2014 is the platform up?",
  "description": "The question somebody asks first, at the moment something is wrong: is anything down, is anything failing, and is anything about to be. Six panels, because a dashboard of forty is one nobody reads during an incident. The money is a different question, asked by a different person, and it has its own dashboard.",
  "tags": [
    "mizan"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services answering",
      "description": "Eight, or something is down. A scrape that stops covering a service looks exactly like a service with nothing wrong, so this counts what answered rather than what was configured.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"mizan\"} == 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Which one, and since when",
      "description": "A count says something is down. This says which, and how long it has been \u2014 the two things the count leaves out and the two things anybody asks next.",
      "gridPos": {
        "h": 5,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"mizan\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "not answering"
                },
                "1": {
                  "text": "answering"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests the platform could not answer",
      "description": "Fives only. A four hundred is a caller being told no, which is the platform working; a five hundred is the platform failing, and they are not the same event however similar the number looks.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"mizan\", status=~\"5..\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "The slowest request each service saw",
      "description": "The worst one in the window, not the average. An average is reassuring during exactly the incident worth noticing, because the requests that are stuck are the ones that have not finished yet and are therefore in no average at all.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (http_server_requests_seconds_max{job=\"mizan\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors being logged",
      "description": "What the services themselves think is wrong, which is often true before anything external has noticed. A rising line here with every other panel flat is the early half of an incident.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(logback_events_total{job=\"mizan\", level=\"error\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Threads waiting for a database connection",
      "description": "The panel that explains a slow platform when nothing is down and nothing is erroring. A pool with everything checked out makes every service behind it look broken and none of them is.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (hikaricp_connections_pending{job=\"mizan\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "The slow end: p95 and p99 of a request",
      "description": "What the slow requests look like, rather than the worst one or the average. Computed from buckets so it can be summed across instances: the p95 of four services is not the mean of their p95s. This platform's tail is wide under load \u2014 p95 sixteen times p50 in the steady load profile \u2014 and until these buckets existed that was only visible to k6, from outside, during a load run.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket{job=\"mizan\", uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{service}} p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_server_requests_seconds_bucket{job=\"mizan\", uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{service}} p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ]
}
