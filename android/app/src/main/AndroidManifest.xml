<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to notice signal coming back, so queued payments are sent. Never to judge a payment. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- To tell the merchant a payment is held for review. Asked for at runtime; refusing it only
         means the held payment is seen on the screen instead. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Plain HTTP is allowed to the local stack only, never anywhere else. See
         res/xml/network_security_config.xml. -->
    <application
        android:name=".MizanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mizan">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
