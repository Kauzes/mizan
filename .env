# The images the platform runs against. Docker Compose reads this file directly, and the
# Gradle build passes the same values to the test harness, so the containers a test starts
# and the containers Compose starts cannot drift apart.
POSTGRES_IMAGE=postgres:18-alpine
KAFKA_IMAGE=apache/kafka:4.3.1
REDIS_IMAGE=redis:8-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.7.3
GRAFANA_IMAGE=grafana/grafana:12.2.1
TEMPO_IMAGE=grafana/tempo:2.9.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.142.0
